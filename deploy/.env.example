POSTGRES_PASSWORD=replace-with-private-database-password
DATABASE_URL=postgresql+psycopg://rpa:replace-with-url-encoded-password@postgres:5432/rpa
AGENT_INTERNAL_TOKEN=replace-with-a-random-private-service-token
DEEPSEEK_API_KEY=replace-with-private-api-key
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
PUBLIC_HOST=console.example.invalid
PUBLIC_URL=https://console.example.invalid
HTTPS_PORT=443
TLS_DIRECTORY=/absolute/private/path/to/certificates
FEISHU_APP_ID=replace-with-app-id
FEISHU_APP_SECRET=replace-with-private-app-secret
FEISHU_TENANT_KEY=replace-with-enterprise-tenant-key
ADMIN_OPEN_IDS=replace-with-admin-open-id
RETENTION_DAYS=30
