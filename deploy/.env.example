# Only these five fields need to be filled in deploy/.env.
DEEPSEEK_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
ADMIN_OPEN_IDS=

# python3 deploy/mac.py prepare generates the database URL, service token,
# ngrok PUBLIC_URL and existing PostgreSQL network in the ignored deploy/.env.
