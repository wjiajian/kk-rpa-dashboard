# 完整部署配置示例；所有 replace-with-* 均须替换。
# 实际服务端为 Linux；Mac 仅用于开发测试。
# Linux：复制为 deploy/.env 后按服务器实际环境填写。
# Mac：直接运行 python3 deploy/mac.py prepare，自动探测并生成私有 deploy/.env。
# 不要用本示例覆盖已经配置好的 .env；真实凭据只保存在被 Git 忽略的 .env 中。

# DeepSeek：仅 Agent 容器使用。
DEEPSEEK_API_KEY='replace-with-deepseek-api-key'
DEEPSEEK_MODEL='deepseek-v4-flash-vision-exp'

# 飞书：同一企业自建应用；open_id 必须属于该应用，多个用英文逗号分隔。
FEISHU_APP_ID='replace-with-feishu-app-id'
FEISHU_APP_SECRET='replace-with-feishu-app-secret'
FEISHU_TENANT_KEY='replace-with-feishu-tenant-key'
ADMIN_OPEN_IDS='replace-with-admin-open-id'

# 对外 HTTPS 根地址，不带路径和末尾 /。
# Linux 使用正式域名；Mac prepare 会填入当前 ngrok HTTPS 地址。
PUBLIC_URL='https://console.example.com'
# Web 仅发布到服务器 127.0.0.1；由宿主机 HTTPS 代理或 Mac ngrok 转发。
WEB_PORT='8088'

# 应用数据库连接；主机名必须能从 backend 容器解析和访问。
# 密码如含 URL 保留字符，先做 URL 编码；不要使用已有业务数据库。
DATABASE_URL='postgresql+psycopg://rpa_console:replace-with-url-encoded-database-password@postgresql:5432/rpa_console'
# 必须是已经存在的 Docker 网络，backend 会加入该网络。
POSTGRES_NETWORK='rpa-db'
# 仅 Mac 辅助脚本探测/初始化数据库使用；Compose 不读取下面两项。
# Linux 直接用 Compose 时不依赖它们，也不会自动创建数据库或角色。
POSTGRES_CONTAINER='postgresql'
POSTGRES_ADMIN='postgres'

# backend 与 Agent 共用的独立随机凭据；Mac prepare 自动生成并保留。
AGENT_INTERNAL_TOKEN='replace-with-random-service-token'
# 仅 backend 使用，用于加密控制台提交的业务凭据。Mac prepare 自动生成并保留。
# Linux 生成 URL-safe Base64 编码的 32 字节随机密钥；备份并保持稳定。
CREDENTIAL_ENCRYPTION_KEY='replace-with-fernet-encryption-key'
# 已结束 Run 的保存天数。
RETENTION_DAYS='30'

# 容器内固定值由 compose.yaml 设置，不是额外的 .env 配置项：
# BACKEND_URL=http://backend:8000
# EVIDENCE_DIR=/data/evidence
# PI_SESSION_DIR=/data/sessions
